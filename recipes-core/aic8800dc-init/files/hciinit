#!/bin/sh
#
# AIC8800DC WiFi/BT initialisation.
#
# Loads the SDIO WiFi/BT modules (via wifi_bt_init.sh), attaches the Bluetooth
# HCI transport on UART1 and brings up the wlan0 interface.

WIFI_INIT=/etc/wifi/wifi_bt_init.sh

check_hciconfig() {
    if ! command -v hciattach >/dev/null 2>&1; then
        return
    fi
    if ! lsmod | grep -q "^aic8800_fdrv"; then
        echo "aic8800_fdrv not loaded, skipping Bluetooth setup."
        return
    fi

    hciattach -s 1500000 /dev/ttyS1 any 1500000 flow nosleep &
    sleep 2
    if hciconfig -a 2>/dev/null | grep -q "hci0"; then
        hciconfig hci0 up &
    else
        echo "hci0 not found or not available."
    fi

    if ifconfig wlan0 >/dev/null 2>&1; then
        ifconfig wlan0 up
        udhcpc -i wlan0 -b >/dev/null 2>&1 &
    fi
}

case "$1" in
    start)
        if [ -x "$WIFI_INIT" ]; then
            "$WIFI_INIT" || echo "wifi_bt_init.sh failed"
        fi
        check_hciconfig &
        ;;
    stop)
        pkill -f "hciattach"
        hciconfig hci0 down 2>/dev/null || true
        if [ -x "$WIFI_INIT" ]; then
            "$WIFI_INIT" stop
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
