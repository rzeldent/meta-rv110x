Subject: [PATCH] drivers: add Rockchip RV1106 NPU driver

Integrate the vendor rknpu driver into the kernel build.

Upstream-Status: Pending [vendor driver is being adapted to this kernel]

---
 drivers/Kconfig  | 1 +
 drivers/Makefile | 1 +
 2 files changed, 2 insertions(+)

diff --git a/drivers/Kconfig b/drivers/Kconfig
index 6e4d105..ec31f0a 100644
--- a/drivers/Kconfig
+++ b/drivers/Kconfig
@@ -109,4 +109,5 @@ source "drivers/video/Kconfig"
 source "drivers/accel/Kconfig"
+source "drivers/rknpu/Kconfig"
 
 source "sound/Kconfig"
 
diff --git a/drivers/Makefile b/drivers/Makefile
index 821e772..4b2e61a 100644
--- a/drivers/Makefile
+++ b/drivers/Makefile
@@ -192,4 +192,5 @@ obj-$(CONFIG_HTE)		+= hte/
 obj-$(CONFIG_DRM_ACCEL)		+= accel/
+obj-$(CONFIG_ROCKCHIP_RKNPU)	+= rknpu/
 obj-$(CONFIG_CDX_BUS)		+= cdx/
 obj-$(CONFIG_DPLL)		+= dpll/
 obj-y				+= resctrl/
-- 
2.43.0
