#include "rv1106.dtsi"

/ {
	chosen {
		stdout-path = "serial2:115200n8";
	};

	aliases {
		ethernet0 = &gmac;
		mmc0 = &emmc;
		mmc1 = &sdmmc;
		mmc2 = &sdio;
		serial2 = &uart2;
	};
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

&gmac {
	clock_in_out = "input";
	phy-supply = <&vcc_3v3>;
	tx_delay = <0x30>;
	rx_delay = <0x10>;
	status = "okay";
};

&sdmmc {
	max-frequency = <50000000>;
	no-sdio;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	status = "okay";
};

&sfc {
	status = "okay";

	spi_nand: flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

&i2c3 {
	pinctrl-0 = <&i2c3m1_xfer>;
};

&i2c4 {
	pinctrl-0 = <&i2c4m2_xfer>;
};

&uart2 {
	status = "okay";
};

&uart3 {
	pinctrl-0 = <&uart3m1_xfer>;
};

&uart4 {
	pinctrl-0 = <&uart4m1_xfer>;
};

&u2phy {
	status = "okay";
};

&u2phy_otg {
	status = "okay";
};

&usbdrd3 {
	status = "okay";
};

&usbdrd_dwc3 {
	dr_mode = "peripheral";
	extcon = <&u2phy>;
	status = "okay";
};
